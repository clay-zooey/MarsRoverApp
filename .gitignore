# Android / Gradle Industry Standard Gitignore

# Gradle files
.gradle/
/build/
/*/build/
/build.gradle
/gradlew
/gradlew.bat
/gradle/wrapper/gradle-wrapper.jar

# Local configuration files
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/shelf/
.idea/runConfigurations/
.idea/copilot/
.idea/modules/
captures/
.externalNativeBuild/
.cxx/

# Built artifacts
*.apk
*.aar
*.ap_
*.der
*.jks
*.keystore
*.pk8
*.pem
*.key

# Kotlin caches and metadata
.kotlin/
.jobs/

# OS specific files
.DS_Store
Thumbs.db

# Crashlytics / Firebase
google-services.json
GoogleService-Info.plist

# Logs and test outputs
*.log
/captures/
/test-reports/
